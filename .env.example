# AI Clipper settings. Copy this file to `.env` and edit; `.env` is git-ignored.
# A variable already set in your shell wins over this file.
# Every line below shows the built-in default; uncomment (or change) only what you need.

# --- Transcription -------------------------------------------------------------
# "cpp" = whisper.cpp (fast, English-leaning); "hf" = the Hinglish transformers model below.
# With "cpp", a transcript that comes out broken (words piled on one timestamp or past the
# end of the audio) is redone with the Hinglish model automatically. Use "hf" to skip the
# wasted first pass when you know the video is Hindi/Hinglish.
AICLIPPER_WHISPER_BACKEND=cpp
AICLIPPER_WHISPER_HF_MODEL=Oriserve/Whisper-Hindi2Hinglish-Apex
# whisper.cpp: binary, model file, spoken language (auto, hi, en, ...), CPU threads
AICLIPPER_WHISPER=whisper-cli
AICLIPPER_WHISPER_MODEL=ggml-small.bin
AICLIPPER_WHISPER_LANG=auto
AICLIPPER_WHISPER_THREADS=4
# transformers backend: device (auto, mps, cpu) and dtype (auto, float16, float32)
# AICLIPPER_WHISPER_DEVICE=auto
# AICLIPPER_WHISPER_DTYPE=auto
# Seconds captions appear before the word is spoken. Default: 0.15 with "hf", else 0.
# AICLIPPER_CAPTION_LEAD_S=0.15

# --- Using the video's own subtitles as the transcript -------------------------
AICLIPPER_SUBTITLES=true
AICLIPPER_SUB_LANGS=hi,en

# --- Clip selection (local LLM, Gemma on MLX) ----------------------------------
AICLIPPER_LLM_MODEL=mlx-community/gemma-4-e2b-it-4bit
AICLIPPER_LLM_MAX_TOKENS=4096
# Lowest rating a clip needs to be kept (AI picking) and lowest relevance for --ask/--brief
AICLIPPER_MIN_CLIP_SCORE=0.3
AICLIPPER_MIN_RELEVANCE=0.6

# --- Audio events (laughter, loudness) as evidence when picking clips ----------
AICLIPPER_AUDIO_EVENTS=true
# AICLIPPER_AUDIO_MODEL=
AICLIPPER_AUDIO_WEIGHT=0.35
# AICLIPPER_AUDIO_DEVICE=auto

# --- Speaker diarization (pyannote) --------------------------------------------
# AICLIPPER_DIAR_MODEL=pyannote/speaker-diarization-3.1
# The pyannote model is gated on Hugging Face: accept its terms, then set a read token.
# HF_TOKEN=

# --- Video ---------------------------------------------------------------------
# Source frames taller than this are downscaled before processing
AICLIPPER_SRC_HEIGHT_CAP=1080

# --- Tools and services --------------------------------------------------------
AICLIPPER_FFMPEG=ffmpeg
AICLIPPER_YTDLP=yt-dlp
AICLIPPER_SIDECAR_URL=http://127.0.0.1:8931
# false = do not start the Python sidecar yourself (it is already running)
AICLIPPER_SIDECAR_START=true
# Default: .venv/bin/python in the project, else python3
# AICLIPPER_PYTHON=/path/to/python
# AICLIPPER_VISION_SHIM=/path/to/libVisionShim.dylib
